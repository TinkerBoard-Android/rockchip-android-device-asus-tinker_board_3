/dts-v1/;
/plugin/;
/ {
	compatible = "rockchip,rk3566";

	fragment@0 {
		target = <&pwm9>;
		__overlay__ {
			status = "okay";
		};
	};
	fragment@1 {
		target = <&backlight>;
		__overlay__ {
			status = "okay";
			power-sequence-reverse;
			minimal-brightness-level = <30>;
			disable_delay = <15>;
		};
	};
	fragment@2 {
		target = <&i2c4>;
		__overlay__ {
			status = "okay";
			dsi_edp_bridge: sn65dsi86@2d {
				status = "okay";
				dsi-lanes = <4>;//u-boot
				data-lanes-size = <2>;//u-boot
				bpc=<8>;//u-boot
				data-lanes = <0 1>;
				lane-polarities = <0 0 0 0>;

				t1=<0>;
				t2=<0>;
				t3=<200>;
				t4=<20>;
				t5=<0>;
				t6=<0>;
				t7=<0>;
				t8=<100>;
				t12= <500>;
				t14= <15>;
				t15 = <15>;
				t16= <15>;
				t17 = <15>;
			};
		};
	};
	fragment@3 {
		target = <&dsi0>;
		__overlay__ {
			status = "okay";
			panel@0 {
				backlight = <&backlight>;
				width-mm = <344>;
				height-mm = <193>;
				bpc=<8>;
				bus-format = <0x100a>;//<MEDIA_BUS_FMT_RGB888_1X24>;
				dsi,flags = <0x3>;
				dsi,format = <0>;//MIPI_DSI_FMT_RGB888:
				dsi,lanes = <4>;

				display-timings {
					native-mode = <&timing86>;

					timing86: timing86  {
				            clock-frequency = <142000000>;
				            hactive = <1920>;
				            vactive = <1080>;
				            hfront-porch = <108>;
				            hsync-len = <48>;
				            hback-porch = <24>;
				            vfront-porch = <10>;
				            vsync-len = <10>;
				            vback-porch = <26>;
				            hsync-active = <0>;
				            vsync-active = <0>;
				            de-active = <1>;
				            pixelclk-active = <0>;
					};
				};
			};
		};
	};
    fragment@4 {
        target = <&dsi0_in_vp1>;
        __overlay__ {
            status = "okay";
        };
    };
    fragment@5 {
       target = <&vp0>;
       __overlay__ {
            rockchip,plane-mask = <42>; //AUX display layer, <(1 << ROCKCHIP_VOP2_CLUSTER1 | 1 << ROCKCHIP_VOP2_SMART1 | 1 << ROCKCHIP_VOP2_ESMART1)>
            rockchip,primary-plane = <5>; //ROCKCHIP_VOP2_SMART1
       };
    };
    fragment@6 {
       target = <&vp1>;
       __overlay__ {
            rockchip,plane-mask = <21>; //MAIN display layer, <(1 << ROCKCHIP_VOP2_CLUSTER0 | 1 << ROCKCHIP_VOP2_SMART0 | 1 << ROCKCHIP_VOP2_ESMART0)>
            rockchip,primary-plane = <4>; //ROCKCHIP_VOP2_SMART0
       };
    };
};
