# RVMON7 CTRL PCB
on early-init

on init
    # led
    start vendor.led
    # ppid
    start vendor.ppid

on late-init

on boot
    # For GPIO FAN
    chown system shell /sys/devices/platform/gpio-fan/hwmon
    chown system shell /sys/devices/platform/gpio-fan/hwmon/hwmon0
    chown system shell /sys/devices/platform/gpio-fan/hwmon/hwmon0/name
    chown system shell /sys/devices/platform/gpio-fan/hwmon/hwmon0/fan_power
    chown system shell /sys/devices/platform/gpio-fan/hwmon/hwmon0/fan_speed

    chmod 0755 /sys/devices/platform/gpio-fan/hwmon
    chmod 0755 /sys/devices/platform/gpio-fan/hwmon/hwmon0
    chmod 0444 /sys/devices/platform/gpio-fan/hwmon/hwmon0/name
    chmod 0666 /sys/devices/platform/gpio-fan/hwmon/hwmon0/fan_power
    chmod 0666 /sys/devices/platform/gpio-fan/hwmon/hwmon0/fan_speed

    # for bmp splash
    # emmc
    chmod 0666 /dev/block/mmcblk2p13
    # sdcard
    chmod 0666 /dev/block/mmcblk0p13

    chmod 0666 /sys/devices/platform/fe5b0000.i2c/i2c-2/2-006f/rtc/rtc0/wakealarm

# For power manager
    chmod 0444 /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_cur_freq
    chmod 0666 /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    chmod 0666 /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
    chmod 0666 /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor

    chown system system /sys/class/devfreq/fde60000.gpu/governor
    chown system system /sys/class/devfreq/fde60000.gpu/min_freq
    chown system system /sys/class/devfreq/fde60000.gpu/max_freq
    chmod 0666 /sys/class/devfreq/fde60000.gpu/governor
    chmod 0666 /sys/class/devfreq/fde60000.gpu/min_freq
    chmod 0666 /sys/class/devfreq/fde60000.gpu/max_freq

# For usb power manager
    chmod 0666 /sys/kernel/debug/fd000000.dwc3/hub_vbus

# watchdog
    start watchdogd

on property:sys.boot_completed=1
    #HDMI CEC
    chown root system /dev/cec0
    chmod 0664 /dev/cec0

service vendor.led /vendor/bin/led.sh
    class main
    user root
    group root
    disabled
    oneshot

service vendor.ppid /vendor/bin/ppid.sh
    class main
    user root
    group root
    disabled
    oneshot

service cpu_gpu_utility /vendor/bin/cpu_gpu_utility.sh
    class main
    user root
    group root
    disabled
    oneshot

on property:persist.sys.run_debugger=0
    setprop vendor.run_debugger 0

on property:vendor.boot_completed=1
    start cpu_gpu_utility

on property:sys.boot_completed=1
    start init-cancfg-sh

service init-cancfg-sh /vendor/bin/init.cancfg.sh
    class main
    user root
    group root system
    oneshot

